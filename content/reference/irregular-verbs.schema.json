{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://werkwoordlab/content/reference/irregular-verbs.schema.json",
  "title": "Werkwoordlab irregular verbs dataset",
  "type": "object",
  "required": [
    "id",
    "title",
    "language",
    "version",
    "source",
    "verbs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "const": "nl"
    },
    "version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "fileName",
        "label",
        "sourcePages",
        "notes"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sourcePages": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lemma",
          "pastSingular",
          "pastPlural",
          "perfectum",
          "auxiliaries",
          "notes"
        ],
        "properties": {
          "lemma": {
            "type": "string"
          },
          "pastSingular": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pastPlural": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "perfectum": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auxiliaries": {
            "type": "array",
            "items": {
              "enum": [
                "hebben",
                "zijn"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
